# MongoDB — use this URI in MongoDB Compass: mongodb://127.0.0.1:27017/caffeine_co
MONGODB_URI=mongodb://127.0.0.1:27017/caffeine_co

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT & cookies
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Initial admin (created on first seed / server start)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@caffeine.co
ADMIN_PASSWORD=ChangeMe123!
